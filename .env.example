# Copy to .env.local and fill in. Never commit real values (T76).
# Local stack: run `pnpm db:start`, then `pnpm exec supabase status -o env` to see the local keys.

# --- Supabase (public values, shipped to the browser) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only secrets: never prefix with NEXT_PUBLIC_ ----------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app (used for email links, redirects and the CORS allowlist)
APP_BASE_URL=http://localhost:3000

# Extra origins allowed to call GET /api/products cross-origin (comma separated, https only)
CORS_ALLOWED_ORIGINS=

# Payments: "simulated" (default, no real money) or "stripe" (Checkout in TEST mode only)
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Simulation area (scenarios / advance / reset). Keep "false" in production.
ENABLE_SIMULATION=false
# Bearer secret for the Vercel cron that advances the simulation (>= 32 random characters)
CRON_SECRET=

# Optional: password for the demo users created by `pnpm db:seed`.
# If empty, a random password is generated and written to .demo-credentials.local (gitignored).
DEMO_USER_PASSWORD=
