# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Payments: "simulated" (default) or "stripe" (test mode only)
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enables the simulation area (scenarios / advance / reset). Keep "false" in production.
ENABLE_SIMULATION=false
APP_BASE_URL=http://localhost:3000
